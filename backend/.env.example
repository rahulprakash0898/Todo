# Server Port
PORT=8000

# MongoDB Connection String (Replace with your MongoDB Atlas or local URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tododb

# JWT Secret Key for token authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here_change_in_production

# Frontend Client URL (e.g. http://localhost:3000 for local dev or https://todo-rahul-dev.vercel.app for production)
CLIENT_URL=https://todo-rahul-dev.vercel.app

# Nodemailer / Gmail SMTP Configuration (Optional for Password Reset & Task Email Alerts)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password
